<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>构妙 LiveCapture</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>构妙需要使用相机来拍摄照片，AI智能构图功能需要实时相机画面来分析最佳构图方案。所有拍摄的照片仅存储在您的设备本地。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>构妙需要访问您的相册以保存拍摄的照片，并读取相册中的照片进行编辑和分享。所有照片数据仅在您的设备本地处理。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>构妙需要将拍摄的照片保存到您的相册中。</string>
	<key>NSMotionUsageDescription</key>
	<string>构妙使用运动传感器来检测设备稳定性，帮助您在对准构图中心时保持稳定，以获得最佳拍摄效果。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>构妙使用麦克风来录制视频时同步采集音频。</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>构妙不会使用本地网络。此权限用于未来可能的设备间传输功能。</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>此标识符将用于向您推荐更精准的拍摄技巧和构图建议，您可以随时在系统设置中关闭此功能。</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh_CN</string>
		<string>en</string>
	</array>
</dict>
</plist>